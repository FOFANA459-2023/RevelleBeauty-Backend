# Copy to .env on the VM and fill in. NEVER commit the filled version.
#   cp .env.example .env && chmod 600 .env

NODE_ENV=production
PORT=4000

# Your storefront's origin (the Cloudflare Worker URL or custom domain).
FRONTEND_URL=https://revellebeauty.com
CORS_ORIGINS=https://revellebeauty.com

# ── Database (Supabase session pooler) ───────────────────────────────
# Special characters in the password must be URL-encoded ('@' -> %40).
DATABASE_URL=

# ── Image storage ────────────────────────────────────────────────────
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Admin ────────────────────────────────────────────────────────────
# The admin signs in on the storefront's normal /login page; this account is
# seeded into the database at boot with role=admin.
ADMIN_EMAIL=
# Plaintext admin password — hashed at boot. Do NOT use ADMIN_PASSWORD_HASH
# here: bcrypt hashes contain '$', which docker-compose interpolates as
# variables and silently corrupts (login then always fails).
ADMIN_PASSWORD=
# openssl rand -base64 48
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12

# ── Stripe (optional — checkout returns 503 until both are set) ──────
STRIPE_CURRENCY=usd
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Cloudflare Tunnel (Mode A only) ──────────────────────────────────
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
CLOUDFLARE_TUNNEL_TOKEN=
