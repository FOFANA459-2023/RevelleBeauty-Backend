# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development                # development | production
PORT=4000
LOG_LEVEL=debug

# ── URLs / CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────
# Leave DATABASE_URL unset in dev to auto-boot an embedded local Postgres
# (data in backend/.pgdata). When Supabase credentials arrive, set the
# session pooler URL from Supabase Dashboard > Connect:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
EMBEDDED_PG_PORT=5544

# ── Image storage ────────────────────────────────────────────────────
# local  -> backend/uploads served at /uploads (dev default)
# supabase -> Supabase Storage bucket (requires the two vars below)
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # 🔴 SECRET — server only, never VITE_*
SUPABASE_STORAGE_BUCKET=product-images

# ── Stripe (optional in dev: absent -> mock checkout) ────────────────
# STRIPE_SECRET_KEY=sk_test_...     # 🔴 SECRET
# STRIPE_WEBHOOK_SECRET=whsec_...   # 🔴 SECRET — from `stripe listen` in dev
STRIPE_CURRENCY=usd

# ── Admin auth ───────────────────────────────────────────────────────
# The admin signs in through the SAME /auth/login as customers; this account
# is seeded into the database at boot with role=admin.
# Dev default password is 'revelle-admin' (ADMIN_DEV_PASSWORD).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=                   # 🔴 SECRET — plaintext, hashed at boot (preferred)
# ...or a bcrypt hash instead (⚠ contains '$' — docker-compose env files
# interpolate '$' and silently corrupt it; if you must use the hash there,
# double every dollar: $2b$12$... -> $$2b$$12$$...):
# ADMIN_PASSWORD_HASH=$2a$12$...    # 🔴 SECRET
# ADMIN_JWT_SECRET=                 # 🔴 SECRET — >=32 chars: openssl rand -base64 48
ADMIN_SESSION_HOURS=12

# ── Outbound email (password resets) ─────────────────────────────────
# console -> logs the email instead of sending (dev default)
# resend  -> Resend HTTPS API — recommended on Oracle Cloud (OCI blocks
#            outbound SMTP port 25; HTTPS is never blocked). Free tier:
#            https://resend.com — create an API key, verify your domain.
# smtp    -> SMTP submission on 587/465 (open on OCI), e.g. Gmail app password
MAIL_DRIVER=console
# MAIL_FROM=Revelle Beauty <no-reply@yourdomain.com>
# RESEND_API_KEY=re_...             # 🔴 SECRET
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false                 # true only for implicit-TLS port 465
# SMTP_USER=you@gmail.com
# SMTP_PASS=                        # 🔴 SECRET — Gmail: an App Password
RESET_TOKEN_TTL_MINUTES=60

# ── Limits ───────────────────────────────────────────────────────────
MAX_CART_LINES=20
MAX_QTY_PER_LINE=10
MAX_UPLOAD_BYTES=5242880
